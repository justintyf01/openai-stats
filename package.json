{
  "name": "openai-readme-stats",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted OpenAI token activity SVGs for your GitHub README.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "test:runtime": "npm run build && node scripts/smoke.mjs",
    "preview": "node --experimental-strip-types scripts/preview.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^22.20.1",
    "miniflare": "5.20260903.0-alpha",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
